# DAVM Configuration
# Copy this file to .env and fill in your values

# Anthropic API Key (required for Claude pilot)
ANTHROPIC_API_KEY=your-api-key-here

# Default pilot to use on startup: "anthropic" or "ollama"
DAVM_DEFAULT_PILOT=ollama

# Default model for each pilot
DAVM_ANTHROPIC_MODEL=claude-sonnet-4-20250514
DAVM_OLLAMA_MODEL=qwen3:8b

# Ollama server URL (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# File system access - comma-separated list of allowed paths
# Leave empty or set to "~" for full home directory access
DAVM_ALLOWED_PATHS=~

# Autonomy level: "ask", "semi", "full"
# ask = always ask permission
# semi = read freely, ask before write/delete
# full = fully autonomous
DAVM_AUTONOMY_LEVEL=semi

# Data storage paths
DAVM_DATA_DIR=./data
DAVM_MEMORY_DIR=./data/memory
DAVM_CONVERSATIONS_DIR=./data/conversations
